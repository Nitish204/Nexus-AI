# Set these as "Environment variables" in the Cloudflare Pages project
# settings (Settings > Environment variables) for BOTH the Production
# and Preview environments — Vite bakes them in at build time, so
# they must exist before the build runs, not just at runtime.

# Your deployed NEXUS backend's base URL (no trailing slash).
# This CANNOT be http://localhost:8000 in production — the backend must
# be reachable over the public internet (Render, Fly, a VPS, etc.).
VITE_API_BASE=https://nexus-ai-wqx2.onrender.com

# Optional — only needed if you use "Continue with Google" on the login page.
VITE_GOOGLE_CLIENT_ID=642248205249-uagc2082nr4mriank0g0bftiq3acjokl.apps.googleusercontent.com

# Optional — only needed if you use "Continue with GitHub" on the login page.
VITE_GITHUB_CLIENT_ID=Ov23ctKXs5NVZsCHe9bG

# Copy to .env and fill in. See config.py for full field list/defaults.

SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-in-production
DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus
REDIS_URL=redis://localhost:6379/0
ALLOWED_ORIGINS=http://localhost:5173,https://your-deployed-frontend.pages.dev

# --- Google / GitHub OAuth (must match the frontend's client IDs) ---
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_MOBILE_CLIENT_ID=
GITHUB_MOBILE_CLIENT_SECRET=

# --- LLM ---
GROQ_API_KEY=
AGENT_MODEL=openai/gpt-oss-120b
LLM_PROVIDER=groq
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1

# --- GitHub repo export ---
GITHUB_EXPORT_TOKEN=

# --- Deployment ---
DEPLOY_PROVIDER=local  # local | render | kubernetes
RENDER_API_KEY=

# --- Web Push notifications (installed PWA) ---
# Generate with: python3 scripts/generate_vapid_keys.py
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Observability ---
# Leave blank to disable Sentry entirely (safe default for local dev).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
# Set from CI to a commit SHA/tag so errors can be bisected to a deploy.
RELEASE_VERSION=unknown

# Point an external uptime monitor at GET /health (liveness) and
# GET /health/ready (readiness: checks DB + Redis) — no extra config
# needed here, they're always on.

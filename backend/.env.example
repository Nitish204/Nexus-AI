# Copy to .env and fill in. See config.py for full field list/defaults.

SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-in-production
DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus
REDIS_URL=redis://localhost:6379/0
ALLOWED_ORIGINS=http://localhost:5173,https://your-deployed-frontend.pages.dev

# --- Google / GitHub OAuth (must match the frontend's client IDs) ---
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- LLM ---
# Cloud (default): Groq
GROQ_API_KEY=
AGENT_MODEL=openai/gpt-oss-120b
# Local: set LLM_PROVIDER=local to route every agent call to a local
# OpenAI-compatible server instead (Ollama/LM Studio/vLLM). No API key
# needed; nothing leaves the machine.
LLM_PROVIDER=groq
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1

# --- GitHub repo export ---
# A PAT with 'repo' scope, used as a fallback when the user isn't
# signed in with GitHub (their own OAuth token is preferred).
GITHUB_EXPORT_TOKEN=

# --- Deployment ---
DEPLOY_PROVIDER=local  # local | render | kubernetes
RENDER_API_KEY=
